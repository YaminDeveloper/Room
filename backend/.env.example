# SquadPing Production Environment Variables

NODE_ENV=production
PORT=8080
HOST=0.0.0.0

# PostgreSQL Connection String
DATABASE_URL=postgresql://squadping:squadpassword_secure_2026@postgres:5432/squadping_db?schema=public

# JWT Security
JWT_SECRET=replace_with_a_64_character_secure_random_key_here
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30

# LiveKit WebRTC SFU Server
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_must_be_at_least_32_characters_long_12345
LIVEKIT_URL=wss://rtc.squadping.gg

# CORS
CORS_ORIGIN=*
